{
  "name": "datanalysx",
  "private": true,
  "version": "1.0.0",
  "description": "DATANALYSX — From Raw Data to Insight. Lab analisis data & data mining di browser: eksplorasi, regresi, klasifikasi, clustering, dan text mining untuk CSV Anda, dengan sembilan studi kasus.",
  "type": "module",
  "license": "MIT",
  "author": "Dea Saka Kurnia Putra",
  "scripts": {
    "sync": "node scripts/sync-assets.mjs",
    "predev": "npm run sync",
    "dev": "vite",
    "prebuild": "npm run sync",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:py": "python -m pytest python/tests -q"
  },
  "dependencies": {
    "docx": "9.5.1",
    "highlight.js": "11.10.0",
    "papaparse": "5.4.1",
    "plotly.js-cartesian-dist-min": "2.35.2",
    "pptxgenjs": "3.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "^22.10.2",
    "@types/papaparse": "5.3.15",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.2",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
